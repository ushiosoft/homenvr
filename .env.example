# Copy to .env and fill in. Never commit .env.
NVR_PASSWORD=change-me          # NVR admin password (same one SSH/RTSP use)
UI_PASSWORD=change-me-too       # password for the homenvr web UI (user: admin)
TZ=UTC                         # set to your IANA timezone, e.g. America/Edmonton
RECORDINGS_DIR=/mnt/storage/cctv  # host path for recordings
TS_AUTHKEY=                     # Tailscale auth key for remote access (optional); see docs/remote-access.md
# WebRTC live view (go2rtc sidecar): addresses browsers can reach this host at.
WEBRTC_LAN_IP=192.168.1.10      # this machine's LAN IP
WEBRTC_TS_IP=                   # the Tailscale sidecar's tailnet IP (100.x.y.z), for remote viewing
